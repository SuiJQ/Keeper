{
  "log_level": "info",
  "max_download_bytes": 1073741824,
  "disable_cross_device_check": false,
  "default_shm_size_mb": 64,
  "download_timeout": "5m",
  "watchdog_timeout": "60s",
  "watchdog_check_interval": "5s",
  "mcp_allowed_uids": [],
  "mcp_allowed_gids": [],
  "seccomp_strategy": "default",
  "overlay_strategy": "default",
  "snapshot_compression_level": 6,
  "network_forward_max_connections": 0,
  "network_forward_connect_timeout": "5s",
  "downloader_threads": 4,
  "downloader_chunk_size": 1048576,
  "downloader_retry_delay": "100ms",
  "storage_max_snapshots": 0,
  "storage_prune_interval": "1h",
  "bwrap_enable_userns": true,
  "bwrap_enable_seccomp": true,
  "metrics_enabled": true,
  "metrics_listen_addr": ":9090"
}
