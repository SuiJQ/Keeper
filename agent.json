        {"after": 8, "action": "stop", "prompt": "Doom loop: stuck in repetitive patterns. Please provide new direction."}
      ]}
    }
  },
  "llm_retry_enabled": true,
  "llm_max_retries": 5,
  "llm_backoff_base": 1,
  "llm_backoff_cap": 30,
  "shell_command_timeout": 120,
  "active_model": {
