      "append_file": {"enabled": true, "display_to_user": true, "async_execution": true, "icon": "📎"},
      "grep_search": {"enabled": true, "display_to_user": true, "async_execution": true, "icon": "🔍"},
      "glob_search": {"enabled": true, "display_to_user": true, "async_execution": true, "icon": "📁"},
      "execute_shell_command": {"enabled": true, "display_to_user": true, "async_execution": true, "icon": "💻"},
      "send_file_to_user": {"enabled": true, "display_to_user": true, "async_execution": true, "icon": "📤"},
      "ast_search": {"enabled": true, "display_to_user": false, "async_execution": true, "icon": "🌳"},
